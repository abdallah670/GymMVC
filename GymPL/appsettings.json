{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/gym-.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=GymAppV2;Integrated Security=SSPI;TrustServerCertificate=True"
  },
  "GymSettings": {
    "IsFirstRun": false
  },

  // SECURITY: no real secrets belong in this file. Use dotnet user-secrets in
  // Development and environment variables in Production, e.g.:
  //   ConnectionStrings__DefaultConnection
  //   EmailSettings__SmtpUser, EmailSettings__SmtpPass
  //   Stripe__SecretKey, Stripe__PublishableKey, Stripe__WebhookSecret
  //   Authentication__Google__ClientId, Authentication__Google__ClientSecret
  //   GeminiSettings__ApiKey
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpUser": "",
    "SmtpPass": "",
    "FromEmail": "",
    "FromName": "MenoPro Gym"
  },

  "Stripe": {
    "PublishableKey": "",
    "SecretKey": "",
    "WebhookSecret": ""
  },

  "Authentication": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },

  "Cors": {
    "AllowedOrigins": [
      "https://localhost:139",
      "http://localhost:139",
      "https://localhost:5001",
      "http://localhost:5000"
    ]
  },

  "AllowedHosts": "*",
  "GeminiSettings": {
    "ApiKey": ""
  }
}
